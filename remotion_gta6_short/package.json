{
  "name": "gta6-short-remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-clips": "node prepare-clips.mjs",
    "studio": "node prepare-clips.mjs && remotion studio src/index.ts",
    "render": "node prepare-clips.mjs && remotion render src/index.ts GTA6Short out/gta6_short_tiktok.mp4 --concurrency=6"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "remotion": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "18.3.12"
  }
}
